{
  "name": "@indoortoolkit/core",
  "version": "0.0.0",
  "description": "Parser and domain model for Simple Indoor Tagging data from raw Overpass JSON.",
  "keywords": [
    "indoor",
    "osm",
    "openstreetmap",
    "overpass",
    "simple-indoor-tagging",
    "routing",
    "map-rendering"
  ],
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "format": "prettier . --write",
    "check:format": "prettier . --check",
    "lint": "oxlint --ignore-path .prettierignore --deny-warnings .",
    "check": "npm run check:format && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.1.2",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
